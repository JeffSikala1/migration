# Install to /etc/systemd/system/bamboo.service on ip-10-56-112-34
#   sudo cp start-bamboo.sh lib-common.sh /app/atlassian-startup/
#   sudo chmod +x /app/atlassian-startup/start-bamboo.sh
#   sudo cp bamboo.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable bamboo.service
#
# `systemctl restart bamboo.service` only re-runs start-bamboo.sh, it does
# NOT touch bitbucket.service, and does not restart prod-postgres if it's
# already running.

[Unit]
Description=Bamboo startup (postgres + bamboo + nginx)
Requires=docker.service
After=docker.service network-online.target app.mount
Wants=network-online.target
# Confirm "app.mount" matches this host's actual mount unit name:
#   systemctl list-units -t mount | grep app

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/app/atlassian-startup
ExecStart=/app/atlassian-startup/start-bamboo.sh
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target